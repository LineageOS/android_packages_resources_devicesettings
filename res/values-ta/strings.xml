    <string name="pick_up_wake_gesture_summary">எடுக்கும்போது, கருவியை விழிப்பூட்டுக</string>
    <string name="pocket_gesture_title">பை</string>
    <string name="pocket_gesture_summary">பையிலிருந்து எடுக்கும்போது, துடிப்பு அறிவிப்புகள்</string>
