    <string name="ambient_display_summary_on">அறிவிப்புகளைப் பெறும்போது, திரை விழித்தெழும்</string>
    <string name="ambient_display_summary_off">அறிவிப்புகளைப் பெறும்போது, திரை விழித்தெழாது</string>
