    <string name="actions_title">செயல்கள்</string>
    <string name="device_gestures_panel_summary">கருவியின் சிறப்புச் சைகைகள்</string>
    <string name="moto_gestures_panel_title">மோட்டோ சைகைகள்</string>
    <string name="camera_gesture_title">இருமுறை திருப்பம்</string>
    <string name="camera_gesture_summary">இருமுறை திருப்பச் சைகையைப் பயன்படுத்தும்போது, படமியைத் திறக்க</string>
    <string name="chop_chop_gesture_title">வெட்டு அசைவு</string>
    <string name="chop_chop_gesture_summary">வெட்டு அசைவுச் சைகையைப் பயன்படுத்தும்போது, ஒளிவிளக்கை நிலைமாற்றுக</string>
    <string name="hand_wave_silencer_title">ஒலியின்மைக்குக் கையசைக்க</string>
    <string name="hand_wave_silencer_summary">திரையின் குறுக்கே கையசைப்பதன் மூலம், உள்வரும் அழைப்புகளை ஒலியின்மையாக்குக</string>
    <string name="flip_to_mute_title">தொந்தரவு செய்யாப் பயன்முறைக்குப் புரட்டுக</string>
    <string name="flip_to_mute_summary">அறிவிப்புகளையும், அழைப்புகளையும் ஒலியடக்கத் திரையைக் கீழே பார்த்தவாறு வைக்க</string>
    <string name="dnd_access">இச்சிறப்பியலைப் பயன்படுத்த, CM நடவடிக்கைகளுக்கான அணுகலை தொந்தரவு செய்யாப் பயன்முறைக்கு வழங்கவும்.</string>
    <string name="lift_to_silence_title">ஒலிப்பதை நிறுத்தத் தொலைபேசியை எடுக்க</string>
    <string name="lift_to_silence_summary">அழைப்பொலியை அடக்கத் தொலைபேசியைத் தூக்குக. இஃது உமது தொலைபேசி தட்டையான நிலையில் இருக்கும்போது மட்டுமே செயற்படும்</string>
    <string name="action_none">முடக்குக</string>
    <string name="action_launch_camera">படமியைத் தொடங்குக</string>
    <string name="action_torch">மின்விளக்கை நிலைமாற்றுக</string>
    <string name="feedback_intensity_title">தொடுவுணர்வு அதிர்வின் செறிவு</string>
    <string name="feedback_intensity_summary">இருமுறை திருப்புதல், வெட்டும் அசைவு ஆகிய செயல்களுக்கான தொடுவுணர்வு அதிர்வின் வலிமை</string>
    <string name="feedback_intensity_none">முடக்கப்பட்டது</string>
