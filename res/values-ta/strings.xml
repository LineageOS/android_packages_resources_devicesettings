    <string name="feedback_intensity_medium">நடுத்தரம்</string>
    <string name="feedback_intensity_high">உயர்வு</string>
    <string name="dialog_ok">சரி</string>
    <string name="disabled">முடக்கப்பட்டது</string>
    <string name="doze_settings_help_title">உதவி</string>
    <string name="doze_settings_help_text">இச்சிறப்பியல்கள், சிறுதுயில் அறிவிப்புகளை இயக்க உணரி நிகழ்வுகளைப் பயன்படுத்துகின்றன. கருவி ஓர் அறிவிப்பைப் பெறும்போது மட்டுமே தேர்ந்தெடுக்கப்பட்ட உணரி இயக்கப்படும்; இது மின்கலப் பயன்பாட்டைக் குறைக்க உதவுகிறது. திரை அணைந்தவுடனேயே உணரியைச் செயற்படுத்தும் விருப்பமும் உள்ளது, ஆனால், இஃது உயர்ந்த மின்கல ஆற்றலைச் செலவிடும்.</string>
    <string name="button_panel_title">கூடுதல் பொத்தான்கள்</string>
    <string name="button_swap_title">பொத்தான்கள் இடமாற்றுக</string>
    <string name="button_swap_summary">அண்மை, பின்செல் பொத்தான்களின் வரிசையை இடமாற்றுக</string>
    <string name="fingerprint_title">விரல்ரேகை</string>
    <string name="fingerprint_as_home_title">முகப்பாக விரல்ரேகை</string>
    <string name="fingerprint_as_home_summary">விரல்ரேகை உணரியை முகப்புப் பொத்தானாகப் பயன்படுத்துக</string>
    <string name="fingerprint_wakeup_title">விரல்ரேகை வழி உணர்த்தல்</string>
    <string name="fingerprint_wakeup_summary">திரை அணைந்திருக்கும்போது, விரல்ரேகை உணரிமூலம் கருவியை விழிப்பூட்ட அனுமதிக்க</string>
    <string name="fingerprint_pocketmode_title">தற்செயலான விழித்தலைத் தடுக்க</string>
    <string name="fingerprint_pocketmode_summary">விரல்ரேகை உணரிமூலம் விழித்தெழுதல்களைத் தூண்டுவதற்கு முன், நெருக்க உணரியைச் சரிபார்க்க</string>
    <string name="fingerprint_sleep_title">விரல்ரேகை வழி உறக்கம்</string>
    <string name="fingerprint_sleep_summary">திரையை அணைக்க விரல்ரேகை உணரியை அழுத்துக</string>
    <string name="high_touch_sensitivity_title">உயர்ந்த தொடு உணர்திறன்</string>
    <string name="high_touch_sensitivity_summary">கையுறைகளை அணிந்திருக்கும்போது பயன்படுத்தும் வகையில், தொடுதிரையின் உணர்திறனை உயர்த்துக</string>
    <string name="quick_charge_title">விரைவு மின்னேற்றம்</string>
    <string name="quick_charge_summary">விரைவு மின்னேற்றத்தை நிலைமாற்றுக. இவ்வமைப்பை மாற்றியப்பின் மின்னேற்றியைத் துண்டித்து மீண்டும் இணைக்க</string>
    <string name="camera_focus_fix_title">படமிக் குவியச் சரிசெய்தல்</string>
    <string name="camera_focus_fix_summary">படமிக் குவியம் செய்வதில் உமக்குச் சிக்கல்கள் இருந்தால், இதை இயக்குக</string>
    <string name="wake_on_gesture_title">சைகைகள்மூலம் விழிப்பூட்டுக</string>
    <string name="wake_on_gesture_summary">சைகைகளின்போது, அறிவிப்புகளைக் காட்டுவதற்குப் பதிலாகக் கருவியை எழுப்புக</string>
    <string name="popup_title">முன் படமி அமைப்புகள்</string>
    <string name="popup_calibration_title">அளவொப்புமை</string>
    <string name="popup_calibration_summary">வெளிவரும் படமியின் இயக்கியை அளவொப்புச் செய்க</string>
    <string name="popup_calibration_warning_title">இயக்கி அளவொப்புமை</string>
    <string name="popup_calibration_warning_text">தேவையற்ற அளவொப்புமை நிலையான பழுதை ஏற்படுத்தலாம். வெளிவரு படமி இயக்கிச் சரியாக நகராதபோதிலோ, தவறான நிலையில் இருந்தாலோ, அதை அளவொப்புச் செய்யப் பரிந்துரைக்கப்படுகிறது!</string>
    <string name="popup_camera_tip">எச்சரிக்கை</string>
