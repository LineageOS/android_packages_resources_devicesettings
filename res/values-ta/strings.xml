    <string name="touchscreen_z_gesture_title">ஒளிவிளக்கு</string>
    <string name="touchscreen_z_gesture_summary">ஒளிவிளக்கை நிலைமாற்ற \"Z\" வடிவம் வரைக</string>
    <string name="touchscreen_flashlight_gesture_title">ஒளிவிளக்கு</string>
    <string name="touchscreen_flashlight_gesture_summary">ஒளிவிளக்கை நிலைமாற்ற ஒரு வட்டம் வரைக</string>
    <string name="touchscreen_music_gesture_title">இசை</string>
    <string name="touchscreen_music_gesture_summary">இசை இயக்கத்தைச் சைகைகள்மூலம் கட்டுப்படுத்துக\n
    • இயக்க/இடைநிறுத்தக் கீழே வருடுக\n
    • முந்தைய பாடலுக்கு இடப்பக்கம் வருடுக\n
    • அடுத்த பாடலுக்கு வலப்பக்கம் வருடுக</string>
    <string name="touchscreen_swipe_up_title">மேல் வருடுக</string>
    <string name="touchscreen_swipe_right_title">வலப்பக்கம் வருடுக</string>
    <string name="touchscreen_swipe_down_title">கீழ் வருடுக</string>
    <string name="touchscreen_swipe_left_title">இடப்பக்கம் வருடுக</string>
    <string name="user_aware_display_title">பயனர் உணர் காட்சி</string>
    <string name="user_aware_display_summary">திரைக்கு முன்னால் பயனர் இருப்பின், திரையைத் தொடர்ந்து ஒளிரச் செய்க.</string>
    <string name="ambient_display_title">சூழல்சார் காட்சி</string>
    <string name="ambient_display_enable_title">சூழல்சார் காட்சியைப் பயன்படுத்துக</string>
    <string name="ambient_display_enable_summary">அறிவிப்புகளைப் பெறும்போது, திரையை விழிப்படையச் செய்யும்</string>
    <string name="ambient_display_gestures_title">சூழல்சார் காட்சிச் சைகைகள்</string>
    <string name="ambient_display_gestures_summary">திரையை விழிப்படையச் செய்யக் கூடுதல் சைகைகள்</string>
    <string name="ambient_display_summary">அறிவிப்புகளைப் பெறும்போது, திரையை விழிப்படையச் செய்யும்</string>
    <string name="ambient_display_summary_on">அறிவிப்புகளைப் பெறும்போது, திரை விழிப்படையும்</string>
    <string name="ambient_display_summary_off">அறிவிப்புகளைப் பெறும்போது, திரை விழிப்படையாது</string>
    <string name="ambient_display_always_on_title">எப்பொழுதும் இயங்குக</string>
    <string name="ambient_display_always_on_summary">நேரத்தையும், அறிவிப்புச் சின்னங்களையும், பிற தகவலையும் காட்டும். மின்கல நுகர்வு உயரும்.</string>
    <string name="tilt_sensor_title">சாய்வு உணரி</string>
    <string name="pickup_sensor_title">தூக்கல் உணரி</string>
    <string name="proximity_sensor_title">நெருங்கமை உணரி</string>
    <string name="hand_wave_gesture_title">கையசைவு</string>
    <string name="hand_wave_gesture_summary">கையசைவின்போது அறிவிப்புத் துடிப்பைக் காட்டுக</string>
    <string name="hand_wave_gesture_flat_title">நோக்குநிலை கண்டறிதல்</string>
    <string name="hand_wave_gesture_flat_summary">கருவி தட்டையான மேற்பரப்பில் மேல்நோக்கி இருந்தால் மட்டுமே அறிவிப்புத் துடிப்பு நிகழும்</string>
    <string name="pick_up_gesture_title">தூக்குதல்</string>
    <string name="pick_up_gesture_summary">கருவியைத் தூக்கும்போது, அறிவிப்புத் துடிப்பைக் காட்டுக</string>
    <string name="pick_up_wake_gesture_summary">கருவியைத் தூக்கும்போது, விழிப்படையச் செய்க</string>
    <string name="pocket_gesture_title">பை</string>
    <string name="pocket_gesture_summary">பையிலிருந்து எடுக்கும்போது, அறிவிப்புத் துடிப்பைக் காட்டுக</string>
    <string name="proximity_wake_title">நெருங்கமை விழிப்படைதல்</string>
    <string name="proximity_wake_enable_title">நெருங்கமை விழிப்படைதல்</string>
    <string name="proximity_wake_enable_summary">கையசைவின்போது கருவியை விழிப்படையச் செய்க</string>
    <string name="actions_title">செயல்கள்</string>
    <string name="device_gestures_panel_summary">கருவிசார் சிறப்புச் சைகைகள்</string>
    <string name="moto_gestures_panel_title">மோட்டோ சைகைகள்</string>
    <string name="camera_gesture_title">இருமுறை மணிக்கட்டுத் திருப்பம்</string>
    <string name="camera_gesture_summary">இருமுறை மணிக்கட்டுத் திருப்பச் சைகையைப் பயன்படுத்தும்போது படமியைத் திறக்க</string>
    <string name="chop_chop_gesture_title">வெட்டு அசைவு</string>
    <string name="chop_chop_gesture_summary">வெட்டு அசைவுச் சைகையைப் பயன்படுத்தும்போது, ஒளிவிளக்கை நிலைமாற்றுக</string>
    <string name="hand_wave_silencer_title">ஒலியடக்கக் கையசைக்க</string>
    <string name="hand_wave_silencer_summary">திரையின் குறுக்கே கையசைப்பதன் மூலம் உள்வரும் அழைப்புகளை ஒலி அடக்குக</string>
    <string name="flip_to_mute_title">தொந்தரவு செய்யற்க நிலைக்குக் கவிழ்க்க</string>
    <string name="flip_to_mute_summary">அறிவிப்புகளையும் அழைப்புகளையும் ஒலியடக்க, கருவியைத் திரைகீழாகக் கவிழ்த்து வைக்க</string>
    <string name="dnd_access">இச்சிறப்பியலைப் பயன்படுத்த, \'தொந்தரவு செய்யற்க\' அணுகலை CMActions-இற்கு வழங்கவும்.</string>
    <string name="lift_to_silence_title">ஒலிப்பதை நிறுத்தத் தூக்குக</string>
    <string name="lift_to_silence_summary">அழைப்பொலியை அடக்கக் கருவியைத் தூக்குக; இது கருவி தட்டையான நிலையில் இருக்கும்போது மட்டுமே செயற்படும்</string>
    <string name="action_none">முடக்குக</string>
    <string name="action_launch_camera">படமியைத் தொடங்குக</string>
    <string name="action_torch">மின்விளக்கை நிலைமாற்றுக</string>
    <string name="feedback_intensity_title">தொடுவுணர்வு அதிர்வின் செறிவு</string>
    <string name="feedback_intensity_summary">இருமுறை மணிக்கட்டுத் திருப்பம், வெட்டு அசைவு ஆகிய செயல்களுக்கான தொடுவுணர்வு அதிர்வின் வலிமை</string>
    <string name="feedback_intensity_none">முடக்கப்பட்டது</string>
    <string name="feedback_intensity_low">குறைவு</string>
    <string name="feedback_intensity_medium">நடுத்தரம்</string>
    <string name="feedback_intensity_high">மிகுதி</string>
    <string name="dialog_ok">சரி</string>
    <string name="disabled">முடக்கப்பட்டது</string>
    <string name="none">எதுவுமில்லை</string>
    <string name="doze_settings_help_title">உதவி</string>
    <string name="doze_settings_help_text">இச்சிறப்பியல்கள், துயில்நிலை அறிவிப்புகளைத் தூண்ட உணரி நிகழ்வுகளைப் பயன்படுத்துகின்றன. கருவி ஓர் அறிவிப்பைப் பெறும்போது மட்டுமே உணரி செயற்படும்; இது மின்கல நுகர்வைக் குறைக்க உதவும். திரை அணைந்தவுடனேயே உணரியைச் செயற்படுத்தும் வாய்ப்பும் உள்ளது. ஆனால், இஃது உயர்ந்த மின்கல ஆற்றலைச் செலவிடும்.</string>
    <string name="button_panel_title">கூடுதல் பொத்தான்கள்</string>
    <string name="button_swap_title">பொத்தான் இடமாற்றம்</string>
    <string name="button_swap_summary">அண்மை, பின்செல்லும் பொத்தான்களின் வரிசையை இடமாற்றுக</string>
    <string name="fingerprint_title">விரல்ரேகை</string>
    <string name="fingerprint_as_home_title">முகப்பாக விரல்ரேகை</string>
    <string name="fingerprint_as_home_summary">விரல்ரேகை உணரியை முகப்புப் பொத்தானாகப் பயன்படுத்துக</string>
    <string name="fingerprint_wakeup_title">விரல்ரேகை வழி விழிப்படைதல்</string>
    <string name="fingerprint_wakeup_summary">திரை அணைந்திருக்கும்போது, விரல்ரேகை உணரிமூலம் கருவியை விழிப்படைய இசைவளிக்க</string>
    <string name="fingerprint_pocketmode_title">தற்செயலான விழிப்படைதலைத் தவிர்க்க</string>
    <string name="fingerprint_pocketmode_summary">விரல்ரேகை உணரிமூலம் திரை விழிப்படைவதற்கு முன், நெருக்க உணரியைச் சரிபார்க்க</string>
    <string name="fingerprint_sleep_title">விரல்ரேகை வழி துயில்நிலை</string>
    <string name="fingerprint_sleep_summary">திரையை அணைக்க விரல்ரேகை உணரியை அழுத்துக</string>
    <string name="high_touch_sensitivity_title">உயர்ந்த தொடு உணர்திறன்</string>
    <string name="high_touch_sensitivity_summary">கையுறைகளை அணிந்திருக்கும்போது, பயன்படுத்தும் வகையில் தொடுதிரையின் உணர்திறனை உயர்த்துக</string>
    <string name="quick_charge_title">விரைவு மின்னேற்றம்</string>
    <string name="quick_charge_summary">விரைவு மின்னேற்றத்தை நிலைமாற்றுக. இவ்வமைப்பை மாற்றியபின் மின்னேற்றியைத் துண்டித்து மீண்டும் இணைக்க.</string>
    <string name="camera_focus_fix_title">படமிக் குவியச் சீரமைப்பு</string>
    <string name="camera_focus_fix_summary">படமிக் குவியத்தில் சிக்கல் இருப்பின், இதனை இயக்குக</string>
    <string name="wake_on_gesture_title">சைகை வழி விழிப்படைதல்</string>
    <string name="wake_on_gesture_summary">சைகைகளின்போது அறிவிப்புத் துடிப்பைக் காட்டாமல், கருவியை விழிப்படையச் செய்க</string>
    <string name="stylus_panel_title">எழுதுகோல்</string>
    <string name="stylus_panel_summary">எழுதுகோல் செயற்பாடுகளைக் கட்டுப்படுத்துக</string>
    <string name="stylus_removed_category_title">எழுதுகோல் எடுக்கப்பட்டது</string>
    <string name="stylus_inserted_category_title">எழுதுகோல் புகுத்தப்பட்டது</string>
    <string name="stylus_screen_on_when_removed_title">திரையை ஒளிரச் செய்க</string>
    <string name="stylus_screen_on_when_removed_summary">எழுதுகோலை எடுக்கும்போது, திரையை ஒளிரச் செய்க</string>
    <string name="stylus_screen_off_when_inserted_title">திரையை அணைக்க</string>
    <string name="stylus_screen_off_when_inserted_summary">எழுதுகோலைப் புகுத்தும்போது, திரையை அணைக்க</string>
    <string name="stylus_vibrate_title">அதிர்வு</string>
    <string name="stylus_vibrate_when_removed_summary">எழுதுகோலை எடுக்கும்போது, அதிர்வுறச் செய்க.</string>
