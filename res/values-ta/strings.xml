    <string name="touchscreen_s_gesture_title">செய்தியிடல்</string>
    <string name="touchscreen_s_gesture_summary">செய்தியிடல் செயலியைத் திறக்க \"S\" வடிவம் வரைக</string>
    <string name="touchscreen_v_gesture_title">அழைப்பான்</string>
    <string name="touchscreen_v_gesture_summary">அழைப்பான் செயலியைத் திறக்க \"V\" வடிவம் வரைக</string>
    <string name="touchscreen_w_gesture_title">உலாவி</string>
